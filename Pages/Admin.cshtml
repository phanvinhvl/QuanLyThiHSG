@page
@inject AppDbContext Db
@{
    var danhSach = Db.ThiSinhs.OrderByDescending(x => x.NgayDangKy).ToList();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Trang Quản Trị - Duyệt Thi Sinh</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="p-4">
    <div class="container-fluid">
        <h3 class="mb-4">DANH SÁCH ĐĂNG KÝ DỰ THI</h3>
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>STT</th>
                    <th>Họ Tên</th>
                    <th>CCCD/Mã ĐĐ</th>
                    <th>Trường</th>
                    <th>Môn Thi</th>
                    <th>Trạng Thái</th>
                    <th>Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < danhSach.Count; i++)
                {
                    var item = danhSach[i];
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@item.HoTen</td>
                        <td>@item.CCCD</td>
                        <td>@item.TenTruong</td>
                        <td>@item.MonThi</td>
                        <td>
                            <span class="badge @(item.TrangThai == "Đã duyệt" ? "bg-success" : "bg-warning")">
                                @item.TrangThai
                            </span>
                        </td>
                        <td>
                            @if (item.TrangThai != "Đã duyệt")
                            {
                                <button onclick="duyet(@item.Id)" class="btn btn-sm btn-success">Duyệt Hồ Sơ</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <script>
        async function duyet(id) {
            if (confirm("Xác nhận duyệt hồ sơ này?")) {
                await fetch('/api/duyet/' + id, { method: 'POST' });
                location.reload();
            }
        }
    </script>
</body>
</html>