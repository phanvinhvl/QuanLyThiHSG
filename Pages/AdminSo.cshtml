@page
@attribute [IgnoreAntiforgeryToken]
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@{
    if (!User.IsInRole("So")) { Response.Redirect("/Login"); return; }

    if (HttpMethods.IsPost(Request.Method) && Request.Form["action"] == "themTruong")
    {
        var ma = Request.Form["maTruong"].ToString();
        var ten = Request.Form["tenTruong"].ToString();
        var pass = Request.Form["matKhau"].ToString();
        if (!Db.TaiKhoans.Any(x => x.MaTruong == ma))
        {
            Db.TaiKhoans.Add(new TaiKhoan { MaTruong = ma, TenTruong = ten, MatKhau = pass, Role = "Truong" });
            Db.SaveChanges();
        }
    }
    var danhSachTruong = Db.TaiKhoans.Where(x => x.Role == "Truong").ToList();
    var tongThiSinh = Db.ThiSinhs.Count();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Quản Trị Cấp Sở</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="p-4 bg-light">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>TRANG QUẢN TRỊ SỞ GIÁO DỤC</h2>
            <a href="/api/so/export-excel" class="btn btn-success fw-bold">📥 Tải File Excel Toàn Tỉnh (@tongThiSinh Thí sinh)</a>
        </div>

        <div class="card p-3 mb-4 shadow-sm">
            <h5>Cấp Tài Khoản Mới Cho Trường</h5>
            <form method="post" class="row g-2">
                <input type="hidden" name="action" value="themTruong">
                <div class="col-md-3"><input type="text" name="maTruong" class="form-control" placeholder="Mã Trường (viết liền)" required></div>
                <div class="col-md-4"><input type="text" name="tenTruong" class="form-control" placeholder="Tên Trường THPT/THCS" required></div>
                <div class="col-md-3"><input type="text" name="matKhau" class="form-control" placeholder="Mật khẩu bàn giao" required></div>
                <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">Tạo Tài Khoản</button></div>
            </form>
        </div>

        <h5>Danh Sách Tài Khoản Các Trường</h5>
        <table class="table table-bordered bg-white">
            <thead class="table-dark">
                <tr><th>STT</th><th>Mã Trường</th><th>Tên Trường</th><th>Mật Khẩu Bàn Giao</th><th>Số HS Đã Đăng Ký</th></tr>
            </thead>
            <tbody>
                @for (int i = 0; i < danhSachTruong.Count; i++)
                {
                    var tr = danhSachTruong[i];
                    var count = Db.ThiSinhs.Count(x => x.MaTruong == tr.MaTruong);
                    <tr>
                        <td>@(i + 1)</td>
                        <td><b>@tr.MaTruong</b></td>
                        <td>@tr.TenTruong</td>
                        <td><code>@tr.MatKhau</code></td>
                        <td><span class="badge bg-info text-dark">@count HS</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>
