@page
@attribute [IgnoreAntiforgeryToken]
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@{
    if (!User.IsInRole("So")) { Response.Redirect("/login"); return; }
    var danhSachTruong = Db.TaiKhoans.Where(x => x.Role == "Truong").ToList();
    var danhSachMon = Db.DanhMucMonThis.OrderBy(x => x.MaMon).ToList();
    var tongThiSinh = Db.ThiSinhs.Count();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Quản Trị Cấp Sở - Hệ Thống Thi HSG</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="p-4 bg-light">
    <div class="container-fluid" style="max-width: 1200px;">
        <!-- HEADER TRANG -->
        <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-white rounded shadow-sm">
            <div>
                <h3 class="fw-bold text-primary mb-1">TRANG QUẢN TRỊ SỞ GIÁO DỤC</h3>
                <span class="text-muted small">Tổng số học sinh đã đăng ký: <b>@tongThiSinh</b> thí sinh</span>
            </div>
            <div>
                <a href="/danhsachphongthi" class="btn btn-outline-info fw-bold me-2">📋 Xem & In Phòng Thi</a>
                <button onclick="chiaPhongThi()" class="btn btn-warning fw-bold me-2">⚡ Chia Phòng & Đánh SBD</button>
                <a href="/api/so/export-excel" class="btn btn-success fw-bold">📥 Tải File Excel Tổng Hợp</a>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <!-- BẢNG 1: QUẢN LÝ DANH MỤC MÔN THI (3 CỘT: STT - MÃ MÔN - TÊN MÔN) -->
            <div class="col-md-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
                        <h5 class="card-title m-0 fs-6 fw-bold">📌 DANH MỤC MÔN THI QUY ĐỊNH (@danhSachMon.Count môn)</h5>
                        <button class="btn btn-light btn-sm fw-bold text-primary" data-bs-toggle="modal" data-bs-target="#modalThemMon">+ Thêm Môn</button>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive" style="max-height: 320px; overflow-y: auto;">
                            <table class="table table-hover table-striped align-middle m-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th class="text-center" style="width: 50px;">STT</th>
                                        <th class="text-center" style="width: 90px;">Mã Môn</th>
                                        <th>Tên Môn Thi</th>
                                        <th class="text-center" style="width: 120px;">Thao Tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (danhSachMon.Count == 0)
                                    {
                                        <tr><td colspan="4" class="text-center text-muted py-3">Chưa có môn thi nào trong danh mục.</td></tr>
                                    }
                                    else
                                    {
                                        @for (int i = 0; i < danhSachMon.Count; i++)
                                        {
                                            var m = danhSachMon[i];
                                            <tr>
                                                <td class="text-center text-muted">@(i + 1)</td>
                                                <td class="text-center"><code class="fw-bold fs-6 text-primary">@(m.MaMon ?? (i + 1).ToString("D2"))</code></td>
                                                <td><span class="fw-bold text-dark" id="mon-name-@m.Id">@m.TenMon</span></td>
                                                <td class="text-center">
                                                    <button onclick="moModalSuaMon(@m.Id, '@m.TenMon')" class="btn btn-outline-warning btn-sm px-2 py-0 me-1">Sửa</button>
                                                    <button onclick="xoaMonThi(@m.Id, '@m.TenMon')" class="btn btn-outline-danger btn-sm px-2 py-0">Xóa</button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- BẢNG 2: IMPORT TÀI KHOẢN TRƯỜNG BẰNG EXCEL -->
            <div class="col-md-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-success text-white py-3">
                        <h5 class="card-title m-0 fs-6 fw-bold">📂 IMPORT TÀI KHOẢN TRƯỜNG TỪ EXCEL</h5>
                    </div>
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <p class="text-muted small mb-2">Định dạng file Excel hỗ trợ: <b>Cột A (Mã Trường), Cột B (Tên Trường), Cột C (Mật Khẩu Bàn Giao)</b>.</p>
                            <form id="formImportTruong" class="mb-3">
                                <div class="mb-3">
                                    <input type="file" id="fileExcelTruong" accept=".xlsx" class="form-control" required>
                                </div>
                                <button type="submit" id="btnImportTruong" class="btn btn-success w-100 fw-bold">Tải Lên File Excel Trường</button>
                            </form>
                            <div id="statusImport"></div>
                        </div>
                        <div class="alert alert-info mb-0 small">
                            💡 <b>Lưu ý:</b> Hệ thống sẽ tự động bỏ qua nếu Mã Trường đã tồn tại trong danh mục tài khoản.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- BẢNG 3: DANH SÁCH TÀI KHOẢN CÁC TRƯỜNG -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                <h5 class="card-title m-0 fs-6 fw-bold">🏫 DANH SÁCH TÀI KHOẢN CÁC TRƯỜNG (@danhSachTruong.Count trường)</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle m-0">
                        <thead class="table-secondary">
                            <tr>
                                <th class="text-center" style="width: 60px;">STT</th>
                                <th style="width: 180px;">Mã Trường</th>
                                <th>Tên Trường THPT / THCS</th>
                                <th style="width: 180px;">Mật Khẩu Bàn Giao</th>
                                <th class="text-center" style="width: 180px;">Số HS Đã Đăng Ký</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (danhSachTruong.Count == 0)
                            {
                                <tr><td colspan="5" class="text-center text-muted py-3">Chưa có tài khoản trường nào được khởi tạo.</td></tr>
                            }
                            else
                            {
                                @for (int i = 0; i < danhSachTruong.Count; i++)
                                {
                                    var tr = danhSachTruong[i];
                                    var count = Db.ThiSinhs.Count(x => x.MaTruong == tr.MaTruong);
                                    <tr>
                                        <td class="text-center text-muted">@(i + 1)</td>
                                        <td><code class="fw-bold fs-6">@tr.MaTruong</code></td>
                                        <td><span class="fw-bold text-dark">@tr.TenTruong</span></td>
                                        <td><span class="badge bg-light text-dark border">@tr.MatKhau</span></td>
                                        <td class="text-center">
                                            <span class="badge bg-primary rounded-pill px-3 py-2">@count học sinh</span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL THÊM MÔN THI MỚI -->
    <div class="modal fade" id="modalThemMon" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fs-6 fw-bold">Thêm Môn Thi Mới Vào Danh Mục</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên Môn Thi</label>
                        <input type="text" id="txtTenMonMoi" class="form-control" placeholder="Ví dụ: Giáo Dục Công Dân">
                        <small class="text-muted">Mã môn sẽ tự động tạo theo dạng 01, 02, 03...</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" onclick="themMonThi()" class="btn btn-primary">Xác Nhận Thêm</button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL SỬA TÊN MÔN THI -->
    <div class="modal fade" id="modalSuaMon" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fs-6 fw-bold">Đổi Tên Môn Thi</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editMonId">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên Môn Thi Mới</label>
                        <input type="text" id="editTenMon" class="form-control" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" onclick="luuSuaMonThi()" class="btn btn-warning fw-bold">Lưu Thay Đổi</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let modalSuaMonBS;
        document.addEventListener("DOMContentLoaded", () => {
            modalSuaMonBS = new bootstrap.Modal(document.getElementById('modalSuaMon'));
        });

        function moModalSuaMon(id, tenMon) {
            document.getElementById('editMonId').value = id;
            document.getElementById('editTenMon').value = tenMon;
            modalSuaMonBS.show();
        }

        async function luuSuaMonThi() {
            const id = document.getElementById('editMonId').value;
            const tenMon = document.getElementById('editTenMon').value;
            if(!tenMon) return alert("Vui lòng nhập tên môn thi!");

            const res = await fetch(`/api/so/sua-mon/${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ tenMon })
            });

            const data = await res.json();
            alert(data.message);
            if(res.ok) location.reload();
        }

        async function themMonThi() {
            const tenMon = document.getElementById('txtTenMonMoi').value;
            if(!tenMon) return alert("Vui lòng nhập tên môn thi!");

            const res = await fetch('/api/so/them-mon', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ tenMon })
            });
            const data = await res.json();
            alert(data.message);
            if(res.ok) location.reload();
        }

        async function xoaMonThi(id, tenMon) {
            if(confirm(`Bạn có chắc chắn muốn xóa môn '${tenMon}' khỏi danh mục?`)) {
                const res = await fetch(`/api/so/xoa-mon/${id}`, { method: 'DELETE' });
                const data = await res.json();
                alert(data.message);
                if(res.ok) location.reload();
            }
        }

        document.getElementById('formImportTruong').onsubmit = async (e) => {
            e.preventDefault();
            const btn = document.getElementById('btnImportTruong');
            const fileInput = document.getElementById('fileExcelTruong');
            const divStatus = document.getElementById('statusImport');

            btn.disabled = true; btn.innerText = 'Đang xử lý tải lên...';
            const formData = new FormData();
            formData.append('file', fileInput.files[0]);

            try {
                const res = await fetch('/api/so/import-truong', { method: 'POST', body: formData });
                const data = await res.json();
                if (res.ok) { alert(data.message); location.reload(); }
                else { divStatus.innerHTML = `<div class="alert alert-danger mb-0">${data.message}</div>`; btn.disabled = false; btn.innerText = 'Tải Lên File Excel Trường'; }
            } catch {
                divStatus.innerHTML = `<div class="alert alert-danger mb-0">Lỗi máy chủ!</div>`; btn.disabled = false; btn.innerText = 'Tải Lên File Excel Trường';
            }
        };

        async function chiaPhongThi() {
            const hsPerPhong = prompt("Nhập số lượng học sinh tối đa trong 1 phòng thi:", "24");
            if (!hsPerPhong) return;
            if (confirm(`Xác nhận đánh SBD và chia phòng thi với quy mô ${hsPerPhong} HS/phòng?`)) {
                const res = await fetch('/api/so/chia-phong', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ soHocSinhMoiPhong: parseInt(hsPerPhong) })
                });
                const data = await res.json();
                alert(data.message);
                location.reload();
            }
        }
    </script>
</body>
</html>
