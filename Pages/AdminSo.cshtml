@page
@attribute [IgnoreAntiforgeryToken]
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@{
    if (!User.IsInRole("So")) { Response.Redirect("/login"); return; }
    var danhSachTruong = Db.TaiKhoans.Where(x => x.Role == "Truong").ToList();
    var danhSachMon = Db.DanhMucMonThis.OrderBy(x => x.TenMon).ToList();
    var tongThiSinh = Db.ThiSinhs.Count();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Quản Trị Cấp Sở</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="p-4 bg-light">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>TRANG QUẢN TRỊ SỞ GIÁO DỤC</h2>
            <div>
                <button onclick="chiaPhongThi()" class="btn btn-warning fw-bold me-2">⚡ Chia Phòng & Đánh SBD</button>
                <a href="/api/so/export-excel" class="btn btn-success fw-bold">📥 Tải File Excel Tổng Hợp (@tongThiSinh HS)</a>
            </div>
        </div>

        <!-- QUẢN LÝ DANH MỤC MÔN THI -->
        <div class="card p-3 mb-4 shadow-sm border-primary">
            <h5 class="text-primary">📌 Quản Lý Danh Mục Môn Thi Quy Định</h5>
            <div class="row g-3 align-items-center">
                <div class="col-md-6 d-flex gap-2">
                    <input type="text" id="txtTenMonMoi" class="form-control" placeholder="Nhập tên môn thi mới (ví dụ: GDCD)...">
                    <button onclick="themMonThi()" class="btn btn-primary text-nowrap">Thêm Môn</button>
                </div>
                <div class="col-md-12">
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        @foreach (var m in danhSachMon)
                        {
                            <span class="badge bg-secondary p-2 fs-6">
                                @m.TenMon 
                                <a href="javascript:void(0)" onclick="xoaMonThi(@m.Id, '@m.TenMon')" class="text-white ms-2 text-decoration-none">&times;</a>
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card p-3 shadow-sm h-100">
                    <h5>Import Danh Sách Trường từ Excel</h5>
                    <p class="text-muted small mb-1">Cột A (Mã Trường), Cột B (Tên Trường), Cột C (Mật khẩu)</p>
                    <form id="formImportTruong" class="d-flex gap-2">
                        <input type="file" id="fileExcelTruong" accept=".xlsx" class="form-control" required>
                        <button type="submit" class="btn btn-success text-nowrap">Import Excel</button>
                    </form>
                </div>
            </div>
        </div>

        <h5>Danh Sách Tài Khoản Các Trường (@danhSachTruong.Count trường)</h5>
        <table class="table table-bordered bg-white shadow-sm">
            <thead class="table-dark">
                <tr><th>STT</th><th>Mã Trường</th><th>Tên Trường</th><th>Mật Khẩu</th><th>Số HS Đăng Ký</th></tr>
            </thead>
            <tbody>
                @for (int i = 0; i < danhSachTruong.Count; i++)
                {
                    var tr = danhSachTruong[i];
                    var count = Db.ThiSinhs.Count(x => x.MaTruong == tr.MaTruong);
                    <tr>
                        <td>@(i + 1)</td>
                        <td><b>@tr.MaTruong</b></td>
                        <td>@tr.TenTruong</td>
                        <td><code>@tr.MatKhau</code></td>
                        <td><span class="badge bg-info text-dark">@count HS</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <script>
        async function themMonThi() {
            const tenMon = document.getElementById('txtTenMonMoi').value;
            if(!tenMon) return alert("Vui lòng nhập tên môn thi!");

            const res = await fetch('/api/so/them-mon', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ tenMon })
            });
            const data = await res.json();
            alert(data.message);
            if(res.ok) location.reload();
        }

        async function xoaMonThi(id, tenMon) {
            if(confirm(`Xóa môn '${tenMon}' khỏi danh mục?`)) {
                const res = await fetch(`/api/so/xoa-mon/${id}`, { method: 'DELETE' });
                const data = await res.json();
                alert(data.message);
                if(res.ok) location.reload();
            }
        }

        async function chiaPhongThi() {
            const hsPerPhong = prompt("Nhập số lượng HS tối đa trong 1 phòng thi:", "24");
            if (!hsPerPhong) return;
            const res = await fetch('/api/so/chia-phong', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ soHocSinhMoiPhong: parseInt(hsPerPhong) })
            });
            const data = await res.json();
            alert(data.message);
            location.reload();
        }
    </script>
</body>
</html>
