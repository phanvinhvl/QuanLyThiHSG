@page
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Đăng Ký Thi Học Sinh Giỏi</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
    <div class="container mt-5" style="max-width: 600px;">
        <div class="card shadow p-4">
            <h3 class="text-center text-primary mb-4">ĐĂNG KÝ THI HỌC SINH GIỎI</h3>
            <form id="formDangKy">
                <div class="mb-3">
                    <label class="form-label">Họ và tên học sinh</label>
                    <input type="text" id="hoTen" class="form-control" required placeholder="Nguyễn Văn A">
                </div>
                <div class="mb-3">
                    <label class="form-label">Số CCCD / Mã định danh</label>
                    <input type="text" id="cccd" class="form-control" required placeholder="001234567890">
                </div>
                <div class="mb-3">
                    <label class="form-label">Trường THPT / THCS</label>
                    <input type="text" id="tenTruong" class="form-control" required placeholder="THPT Chuyên...">
                </div>
                <div class="mb-3">
                    <label class="form-label">Môn đăng ký thi</label>
                    <select id="monThi" class="form-select" required>
                        <option value="">-- Chọn môn thi --</option>
                        <option value="Toán">Toán Hóa</option>
                        <option value="Vật Lý">Vật Lý</option>
                        <option value="Hóa Học">Hóa Học</option>
                        <option value="Ngữ Văn">Ngữ Văn</option>
                        <option value="Tiếng Anh">Tiếng Anh</option>
                        <option value="Tin Học">Tin Học</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary w-100">Gửi Hồ Sơ Đăng Ký</button>
            </form>
            <div id="thongBao" class="mt-3"></div>
        </div>
    </div>

    <script>
        document.getElementById('formDangKy').onsubmit = async (e) => {
            e.preventDefault();
            const data = {
                hoTen: document.getElementById('hoTen').value,
                cccd: document.getElementById('cccd').value,
                tenTruong: document.getElementById('tenTruong').value,
                monThi: document.getElementById('monThi').value
            };

            const res = await fetch('/api/dang-ky', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            const result = await res.json();
            const divTB = document.getElementById('thongBao');
            if (res.ok) {
                divTB.innerHTML = `<div class="alert alert-success">${result.message}</div>`;
                e.target.reset();
            } else {
                divTB.innerHTML = `<div class="alert alert-danger">${result.message}</div>`;
            }
        };
    </script>
</body>
</html>