@page
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Đăng Nhập Hệ Thống Thi HSG</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            height: 100vh;
        }
        .login-card {
            width: 420px;
            border-radius: 12px;
        }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center">
    <div class="card shadow-lg p-4 login-card border-0">
        <div class="text-center mb-4">
            <h4 class="fw-bold text-primary mb-1">HỆ THỐNG THI HSG</h4>
            <span class="text-muted small">SỞ GIÁO DỤC VÀ ĐÀO TẠO VĨNH LONG</span>
        </div>

        <div id="thongBao"></div>

        <form id="formLogin">
            <!-- CHỌN LOẠI TÀI KHOẢN -->
            <div class="mb-3">
                <label class="form-label fw-bold">Loại Tài Khoản</label>
                <select id="roleSelect" class="form-select" onchange="capNhatGiaoDienRole()">
                    <option value="Truong" selected>🏫 Trường THPT / THCS</option>
                    <option value="So">🏛️ Sở Giáo Dục & Đào Tạo</option>
                </select>
            </div>

            <!-- MÃ TÀI KHOẢN -->
            <div class="mb-3">
                <label class="form-label fw-bold" id="lblMaTaiKhoan">Mã Trường</label>
                <input type="text" id="maTruong" class="form-control" required placeholder="Nhập mã trường...">
            </div>

            <!-- MẬT KHẨU -->
            <div class="mb-4">
                <label class="form-label fw-bold">Mật Khẩu</label>
                <input type="password" id="matKhau" class="form-control" required placeholder="Nhập mật khẩu...">
            </div>

            <button type="submit" id="btnLogin" class="btn btn-primary w-100 fw-bold py-2 fs-6">ĐĂNG NHẬP</button>
        </form>
    </div>

    <script>
        // Tự động thay đổi Placeholder & Mã mặc định theo Loại tài khoản chọn
        function capNhatGiaoDienRole() {
            const role = document.getElementById('roleSelect').value;
            const lbl = document.getElementById('lblMaTaiKhoan');
            const txtMa = document.getElementById('maTruong');

            if (role === 'So') {
                lbl.innerText = 'Mã Tài Khoản Sở';
                txtMa.value = 'SO_GD';
                txtMa.placeholder = 'Ví dụ: SO_GD';
            } else {
                lbl.innerText = 'Mã Trường';
                txtMa.value = '';
                txtMa.placeholder = 'Nhập mã trường...';
            }
        }

        // Xử lý gửi API Đăng nhập
        document.getElementById('formLogin').onsubmit = async (e) => {
            e.preventDefault();
            const btn = document.getElementById('btnLogin');
            const divTB = document.getElementById('thongBao');

            btn.disabled = true;
            btn.innerHTML = 'Đang đăng nhập...';
            divTB.innerHTML = '';

            const payload = {
                maTruong: document.getElementById('maTruong').value,
                matKhau: document.getElementById('matKhau').value
            };

            try {
                const res = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await res.json();

                if (res.ok) {
                    window.location.href = data.redirectUrl;
                } else {
                    divTB.innerHTML = `<div class="alert alert-danger py-2 mb-3">${data.message || 'Sai thông tin đăng nhập!'}</div>`;
                    btn.disabled = false;
                    btn.innerHTML = 'ĐĂNG NHẬP';
                }
            } catch (err) {
                divTB.innerHTML = `<div class="alert alert-danger py-2 mb-3">Lỗi kết nối máy chủ!</div>`;
                btn.disabled = false;
                btn.innerHTML = 'ĐĂNG NHẬP';
            }
        };
    </script>
</body>
</html>
