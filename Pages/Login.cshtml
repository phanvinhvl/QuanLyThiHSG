@page
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Đăng Nhập Hệ Thống Thi HSG</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="height: 100vh;">
    <div class="card shadow p-4" style="width: 400px;">
        <h4 class="text-center text-primary mb-3">ĐĂNG NHẬP HỆ THỐNG</h4>
        <div id="thongBao"></div>
        <form id="formLogin">
            <div class="mb-3">
                <label class="form-label">Mã tài khoản (Sở/Mã Trường)</label>
                <input type="text" id="maTruong" class="form-control" required placeholder="Ví dụ: SO_GD">
            </div>
            <div class="mb-3">
                <label class="form-label">Mật khẩu</label>
                <input type="password" id="matKhau" class="form-control" required>
            </div>
            <button type="submit" id="btnLogin" class="btn btn-primary w-100">Đăng Nhập</button>
        </form>
    </div>

    <script>
        document.getElementById('formLogin').onsubmit = async (e) => {
            e.preventDefault();
            const btn = document.getElementById('btnLogin');
            const divTB = document.getElementById('thongBao');
            
            btn.disabled = true;
            btn.innerHTML = 'Đang xử lý...';
            divTB.innerHTML = '';

            const payload = {
                maTruong: document.getElementById('maTruong').value,
                matKhau: document.getElementById('matKhau').value
            };

            try {
                const res = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await res.json();

                if (res.ok) {
                    window.location.href = data.redirectUrl;
                } else {
                    divTB.innerHTML = `<div class="alert alert-danger">${data.message || data.detail || 'Lỗi đăng nhập!'}</div>`;
                    btn.disabled = false;
                    btn.innerHTML = 'Đăng Nhập';
                }
            } catch (err) {
                divTB.innerHTML = `<div class="alert alert-danger">Lỗi kết nối máy chủ!</div>`;
                btn.disabled = false;
                btn.innerHTML = 'Đăng Nhập';
            }
        };
    </script>
</body>
</html>
