@page
@attribute [IgnoreAntiforgeryToken]
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@{
    if (!User.IsInRole("Truong")) { Response.Redirect("/login"); return; }
    var maTruong = User.Identity?.Name;
    var danhSach = Db.ThiSinhs.Where(x => x.MaTruong == maTruong).OrderBy(x => x.HoTen).ToList();
    var danhSachMon = Db.DanhMucMonThis.OrderBy(x => x.TenMon).ToList();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Quản Trị Cấp Trường</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="p-4 bg-light">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="text-primary m-0">ĐĂNG KÝ THI HSG - @User.FindFirst("TenTruong")?.Value</h3>
            <a href="/api/truong/download-mau" class="btn btn-outline-primary fw-bold">📄 Tải File Excel Mẫu</a>
        </div>
        
        <div class="card p-3 mb-4 shadow-sm">
            <h5>Upload Danh Sách Học Sinh Qua Excel</h5>
            <p class="text-muted small mb-2">Chỉ các môn nằm trong Danh mục của Sở mới được duyệt tự động.</p>
            <form id="formUpload" class="d-flex gap-2">
                <input type="file" id="fileExcel" accept=".xlsx" class="form-control" style="max-width: 400px;" required>
                <button type="submit" id="btnUpload" class="btn btn-success">Upload File Excel</button>
            </form>
            <div id="statusUpload" class="mt-2"></div>
        </div>

        <h5>Danh Sách Học Sinh Đã Đăng Ký (@danhSach.Count em)</h5>
        <table class="table table-striped table-bordered bg-white shadow-sm align-middle">
            <thead class="table-dark">
                <tr>
                    <th>STT</th>
                    <th>SBD</th>
                    <th>Phòng Thi</th>
                    <th>Họ và Tên</th>
                    <th>Số CCCD/Định Danh</th>
                    <th>Tên Trường</th>
                    <th>Môn Dự Thi</th>
                    <th class="text-center" style="width: 150px;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < danhSach.Count; i++)
                {
                    var item = danhSach[i];
                    <tr id="row-@item.Id">
                        <td>@(i + 1)</td>
                        <td><b class="text-danger">@(item.SBD ?? "---")</b></td>
                        <td><span class="badge bg-secondary">@(item.PhongThi ?? "---")</span></td>
                        <td><span id="name-@item.Id">@item.HoTen</span></td>
                        <td><span id="cccd-@item.Id">@item.CCCD</span></td>
                        <td><span id="truong-@item.Id">@item.TenTruong</span></td>
                        <td><span class="badge bg-primary" id="mon-@item.Id">@item.MonThi</span></td>
                        <td class="text-center">
                            <button onclick="moModalSua(@item.Id)" class="btn btn-sm btn-warning">Sửa</button>
                            <button onclick="xoaThiSinh(@item.Id)" class="btn btn-sm btn-danger">Xóa</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- MODAL SỬA THÔNG TIN -->
    <div class="modal fade" id="modalEdit" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Chỉnh Sửa Thông Tin Học Sinh</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editId">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Họ và Tên</label>
                        <input type="text" id="editHoTen" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Số CCCD/Định Danh</label>
                        <input type="text" id="editCCCD" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên Trường</label>
                        <input type="text" id="editTenTruong" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Môn Thi (Chỉ chọn môn quy định)</label>
                        <select id="editMonThi" class="form-select">
                            @foreach (var m in danhSachMon)
                            {
                                <option value="@m.TenMon">@m.TenMon</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" onclick="luuThongTinSua()" class="btn btn-primary">Lưu Thay Đổi</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let editModalBS;
        document.addEventListener("DOMContentLoaded", () => {
            editModalBS = new bootstrap.Modal(document.getElementById('modalEdit'));
        });

        function moModalSua(id) {
            document.getElementById('editId').value = id;
            document.getElementById('editHoTen').value = document.getElementById(`name-${id}`).innerText;
            document.getElementById('editCCCD').value = document.getElementById(`cccd-${id}`).innerText;
            document.getElementById('editTenTruong').value = document.getElementById(`truong-${id}`).innerText;
            document.getElementById('editMonThi').value = document.getElementById(`mon-${id}`).innerText;
            editModalBS.show();
        }

        async function luuThongTinSua() {
            const id = document.getElementById('editId').value;
            const payload = {
                hoTen: document.getElementById('editHoTen').value,
                cccd: document.getElementById('editCCCD').value,
                tenTruong: document.getElementById('editTenTruong').value,
                monThi: document.getElementById('editMonThi').value
            };

            const res = await fetch(`/api/truong/sua-thisinh/${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            const data = await res.json();
            if (res.ok) {
                alert(data.message);
                location.reload();
            } else {
                alert(data.message || 'Lỗi chọn môn!');
            }
        }

        async function xoaThiSinh(id) {
            if (confirm("Xóa học sinh này?")) {
                const res = await fetch(`/api/truong/xoa-thisinh/${id}`, { method: 'DELETE' });
                const data = await res.json();
                if (res.ok) location.reload();
            }
        }

        document.getElementById('formUpload').onsubmit = async (e) => {
            e.preventDefault();
            const btn = document.getElementById('btnUpload');
            const statusDiv = document.getElementById('statusUpload');
            const fileInput = document.getElementById('fileExcel');

            btn.disabled = true; btn.innerText = 'Đang tải lên...';
            const formData = new FormData();
            formData.append('file', fileInput.files[0]);

            try {
                const res = await fetch('/api/truong/upload-excel', { method: 'POST', body: formData });
                const data = await res.json();
                alert(data.message);
                location.reload();
            } catch {
                statusDiv.innerHTML = `<div class="alert alert-danger">Lỗi kết nối!</div>`;
                btn.disabled = false; btn.innerText = 'Upload File Excel';
            }
        };
    </script>
</body>
</html>
