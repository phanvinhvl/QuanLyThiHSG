@page
@attribute [IgnoreAntiforgeryToken]
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@{
    if (!User.IsInRole("Truong")) { Response.Redirect("/login"); return; }
    var maTruong = User.Identity?.Name;
    var danhSach = Db.ThiSinhs.Where(x => x.MaTruong == maTruong).OrderBy(x => x.HoTen).ToList();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Quản Trị Cấp Trường</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="p-4 bg-light">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="text-primary m-0">ĐĂNG KÝ THI HSG - @User.FindFirst("TenTruong")?.Value</h3>
            <a href="/api/truong/download-mau" class="btn btn-outline-primary fw-bold">📄 Tải File Excel Mẫu</a>
        </div>
        
        <div class="card p-3 mb-4 shadow-sm">
            <h5>Upload Danh Sách Học Sinh Qua Excel</h5>
            <p class="text-muted small mb-2">Cấu trúc file Excel mẫu: <b>Cột A (Họ Tên), Cột B (Số CCCD), Cột C (Môn Thi)</b>.</p>
            <form id="formUpload" class="d-flex gap-2">
                <input type="file" id="fileExcel" accept=".xlsx" class="form-control" style="max-width: 400px;" required>
                <button type="submit" id="btnUpload" class="btn btn-success">Upload File Excel</button>
            </form>
            <div id="statusUpload" class="mt-2"></div>
        </div>

        <h5>Danh Sách Học Sinh Đã Đăng Ký (@danhSach.Count em)</h5>
        <table class="table table-striped table-bordered bg-white shadow-sm align-middle">
            <thead class="table-dark">
                <tr>
                    <th>STT</th>
                    <th>SBD</th>
                    <th>Phòng Thi</th>
                    <th>Họ và Tên</th>
                    <th>Số CCCD/Định Danh</th>
                    <th>Môn Dự Thi</th>
                    <th class="text-center" style="width: 150px;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < danhSach.Count; i++)
                {
                    var item = danhSach[i];
                    <tr id="row-@item.Id">
                        <td>@(i + 1)</td>
                        <td><b class="text-danger">@(item.SBD ?? "---")</b></td>
                        <td><span class="badge bg-secondary">@(item.PhongThi ?? "---")</span></td>
                        <td><span id="name-@item.Id">@item.HoTen</span></td>
                        <td><span id="cccd-@item.Id">@item.CCCD</span></td>
                        <td><span class="badge bg-primary" id="mon-@item.Id">@item.MonThi</span></td>
                        <td class="text-center">
                            <button onclick="suaThiSinh(@item.Id)" class="btn btn-sm btn-warning">Sửa</button>
                            <button onclick="xoaThiSinh(@item.Id)" class="btn btn-sm btn-danger">Xóa</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <script>
        // Upload File Excel
        document.getElementById('formUpload').onsubmit = async (e) => {
            e.preventDefault();
            const btn = document.getElementById('btnUpload');
            const statusDiv = document.getElementById('statusUpload');
            const fileInput = document.getElementById('fileExcel');

            btn.disabled = true;
            btn.innerText = 'Đang tải lên...';
            statusDiv.innerHTML = '';

            const formData = new FormData();
            formData.append('file', fileInput.files[0]);

            try {
                const res = await fetch('/api/truong/upload-excel', { method: 'POST', body: formData });
                const data = await res.json();
                if (res.ok) {
                    alert(data.message);
                    location.reload();
                } else {
                    statusDiv.innerHTML = `<div class="alert alert-danger">${data.message}</div>`;
                    btn.disabled = false;
                    btn.innerText = 'Upload File Excel';
                }
            } catch {
                statusDiv.innerHTML = `<div class="alert alert-danger">Lỗi kết nối máy chủ!</div>`;
                btn.disabled = false;
                btn.innerText = 'Upload File Excel';
            }
        };

        // Sửa thông tin thí sinh
        async function suaThiSinh(id) {
            const currentName = document.getElementById(`name-${id}`).innerText;
            const currentCCCD = document.getElementById(`cccd-${id}`).innerText;
            const currentMon = document.getElementById(`mon-${id}`).innerText;

            const hoTen = prompt("Sửa Họ và Tên:", currentName);
            if (!hoTen) return;
            const cccd = prompt("Sửa Số CCCD:", currentCCCD);
            if (!cccd) return;
            const monThi = prompt("Sửa Môn Thi:", currentMon);
            if (!monThi) return;

            const res = await fetch(`/api/truong/sua-thisinh/${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ hoTen, cccd, monThi })
            });

            const data = await res.json();
            if (res.ok) {
                alert(data.message);
                location.reload();
            } else {
                alert(data.message);
            }
        }

        // Xóa thí sinh
        async function xoaThiSinh(id) {
            if (confirm("Bạn có chắc chắn muốn xóa học sinh này khỏi danh sách?")) {
                const res = await fetch(`/api/truong/xoa-thisinh/${id}`, { method: 'DELETE' });
                const data = await res.json();
                if (res.ok) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert(data.message);
                }
            }
        }
    </script>
</body>
</html>
