@page
@attribute [IgnoreAntiforgeryToken]
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@{
    var listPhong = Db.ThiSinhs.Where(x => !string.IsNullOrEmpty(x.PhongThi)).Select(x => x.PhongThi).Distinct().OrderBy(x => x).ToList();
    string selectedPhong = Request.Query["phong"].ToString();
    if (string.IsNullOrEmpty(selectedPhong) && listPhong.Count > 0)
    {
        selectedPhong = listPhong[0];
    }
    var dsThiSinh = Db.ThiSinhs.Where(x => x.PhongThi == selectedPhong).OrderBy(x => x.SBD).ToList();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Danh Sách Phòng Thi - @selectedPhong</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        @@media print {
            .no-print { display: none !important; }
            body { padding: 0 !important; background: white !important; }
            .card { border: none !important; shadow: none !important; }
        }
    </style>
</head>
<body class="p-4 bg-light">
    <div class="container">
        <!-- Thanh công cụ (Ẩn khi In) -->
        <div class="card p-3 mb-4 shadow-sm no-print">
            <div class="d-flex justify-content-between align-items-center">
                <form method="get" class="d-flex gap-2 align-items-center">
                    <label class="fw-bold text-nowrap">Chọn Phòng Thi:</label>
                    <select name="phong" class="form-select" onchange="this.form.submit()">
                        @foreach (var p in listPhong)
                        {
                            <option value="@p" selected="@(p == selectedPhong)">Phòng: @p</option>
                        }
                    </select>
                </form>
                <div>
                    <button onclick="window.print()" class="btn btn-primary fw-bold me-2">🖨️ In / Tải PDF Phòng Bài</button>
                    <a href="/api/so/export-phong-thi" class="btn btn-success fw-bold">📥 Tải Tất Cả Phòng (Excel)</a>
                </div>
            </div>
        </div>

        <!-- Mẫu Bảng Điểm Danh Phòng Thi (Chuẩn khổ A4) -->
        <div class="card p-4 shadow-sm bg-white">
            <div class="text-center mb-4">
                <h5 class="m-0 text-uppercase">SỞ GIÁO DỤC VÀ ĐÀO TẠO</h5>
                <h3 class="fw-bold my-2">DANH SÁCH THÍ SINH DỰ THI HỌC SINH GIỎI</h3>
                <h4 class="text-primary fw-bold">PHÒNG THI: @(selectedPhong ?? "CHƯA CHỌN PHÒNG")</h4>
            </div>

            <table class="table table-bordered align-middle">
                <thead class="table-light text-center">
                    <tr>
                        <th style="width: 50px;">STT</th>
                        <th style="width: 100px;">SBD</th>
                        <th>Họ và Tên</th>
                        <th style="width: 130px;">Số CCCD</th>
                        <th>Trường THPT/THCS</th>
                        <th style="width: 110px;">Môn Thi</th>
                        <th style="width: 140px;">Chữ Ký Thí Sinh</th>
                    </tr>
                </thead>
                <tbody>
                    @if (dsThiSinh.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted">Chưa có dữ liệu thí sinh trong phòng này.</td></tr>
                    }
                    else
                    {
                        @for (int i = 0; i < dsThiSinh.Count; i++)
                        {
                            var ts = dsThiSinh[i];
                            <tr>
                                <td class="text-center">@(i + 1)</td>
                                <td class="text-center fw-bold text-danger">@ts.SBD</td>
                                <td><b>@ts.HoTen</b></td>
                                <td class="text-center">@ts.CCCD</td>
                                <td>@ts.TenTruong</td>
                                <td class="text-center"><span class="badge bg-primary">@ts.MonThi</span></td>
                                <td></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <div class="row mt-4 pt-3 no-print-break">
                <div class="col-6 text-center">
                    <p class="fw-bold mb-5">GIÁM THỊ 1<br><small class="fw-normal">(Ký và ghi rõ họ tên)</small></p>
                </div>
                <div class="col-6 text-center">
                    <p class="fw-bold mb-5">GIÁM THỊ 2<br><small class="fw-normal">(Ký và ghi rõ họ tên)</small></p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
