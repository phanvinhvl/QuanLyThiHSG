@page
@attribute [IgnoreAntiforgeryToken]
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@{
    var listPhong = Db.ThiSinhs.Where(x => !string.IsNullOrEmpty(x.PhongThi)).Select(x => x.PhongThi).Distinct().OrderBy(x => x).ToList();
    string selectedPhong = Request.Query["phong"].ToString();
    if (string.IsNullOrEmpty(selectedPhong) && listPhong.Count > 0)
    {
        selectedPhong = listPhong[0];
    }
    var dsThiSinh = Db.ThiSinhs.Where(x => x.PhongThi == selectedPhong).OrderBy(x => x.SBD).ToList();
    string monThi = dsThiSinh.FirstOrDefault()?.MonThi ?? ".....";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Danh Sách Phòng Thi - @selectedPhong</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        @@media print {
            .no-print { display: none !important; }
            body { padding: 0 !important; background: white !important; }
            .card { border: none !important; box-shadow: none !important; }
        }
        .header-title { font-family: "Times New Roman", Times, serif; }
    </style>
</head>
<body class="p-4 bg-light">
    <div class="container">
        <!-- BAR CÔNG CỤ (ẨN KHI IN) -->
        <div class="card p-3 mb-4 shadow-sm no-print">
            <div class="d-flex justify-content-between align-items-center">
                <form method="get" class="d-flex gap-2 align-items-center">
                    <label class="fw-bold text-nowrap">Chọn Phòng Thi:</label>
                    <select name="phong" class="form-select" onchange="this.form.submit()">
                        @foreach (var p in listPhong)
                        {
                            <option value="@p" selected="@(p == selectedPhong)">Phòng: @p</option>
                        }
                    </select>
                </form>
                <div>
                    <button onclick="window.print()" class="btn btn-primary fw-bold me-2">🖨️ In / Tải PDF A4</button>
                    <a href="/api/so/export-phong-thi" class="btn btn-success fw-bold">📥 Tải Excel Các Phòng Thi</a>
                </div>
            </div>
        </div>

        <!-- KHUNG MẪU IN TỜ TỜ KHỔ A4 (CHUẨN MẪU SỞ GD&ĐT VĨNH LONG) -->
        <div class="card p-5 shadow-sm bg-white header-title">
            
            <!-- HEADER THEO MẪU GIỐNG HÌNH -->
            <div class="row mb-4">
                <div class="col-6 text-center">
                    <h6 class="fw-bold mb-1">SỞ GIÁO DỤC VÀ ĐÀO TẠO VĨNH LONG</h6>
                    <h6 class="fw-bold mb-1">KỲ THI HỌC SINH GIỎI THPT CẤP TỈNH</h6>
                    <h6 class="fw-bold text-decoration-underline">Khóa ngày @DateTime.Now.ToString("dd/MM/yyyy")</h6>
                </div>
                <div class="col-6 text-center">
                    <h5 class="fw-bold mb-2">DANH SÁCH PHÒNG THI SỐ: <span class="text-danger">@selectedPhong</span></h5>
                    <h6 class="fw-bold">MÔN: <span class="text-uppercase text-primary">@monThi</span></h6>
                </div>
            </div>

            <!-- BẢNG DANH SÁCH THÍ SINH -->
            <table class="table table-bordered align-middle my-3 border-dark">
                <thead class="text-center align-middle" style="background-color: #f2f2f2;">
                    <tr>
                        <th style="width: 50px;">STT</th>
                        <th style="width: 100px;">SBD</th>
                        <th>Họ và Tên</th>
                        <th style="width: 130px;">Số CCCD</th>
                        <th>Trường THPT/THCS</th>
                        <th style="width: 110px;">Môn Thi</th>
                        <th style="width: 140px;">Chữ Ký Thí Sinh</th>
                    </tr>
                </thead>
                <tbody>
                    @if (dsThiSinh.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted">Chưa có dữ liệu thí sinh trong phòng này.</td></tr>
                    }
                    else
                    {
                        @for (int i = 0; i < dsThiSinh.Count; i++)
                        {
                            var ts = dsThiSinh[i];
                            <tr>
                                <td class="text-center">@(i + 1)</td>
                                <td class="text-center fw-bold">@ts.SBD</td>
                                <td><b>@ts.HoTen</b></td>
                                <td class="text-center">@ts.CCCD</td>
                                <td>@ts.TenTruong</td>
                                <td class="text-center">@ts.MonThi</td>
                                <td></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <!-- FOOTER CHỦ TỊCH HỘI ĐỒNG (CĂN PHẢI THEO MẪU HÌNH) -->
            <div class="row mt-4 pt-3">
                <div class="col-6"></div>
                <div class="col-6 text-center">
                    <p class="fw-bold mb-5">CHỦ TỊCH HỘI ĐỒNG/BAN COI THI</p>
                </div>
            </div>

        </div>
    </div>
</body>
</html>
