@page
@attribute [IgnoreAntiforgeryToken]
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@{
    if (!User.IsInRole("So")) { Response.Redirect("/login"); return; }
    var dsCanBo = Db.CanBoCoiThis.ToList();
    var tongPhong = Db.ThiSinhs.Where(x => !string.IsNullOrEmpty(x.PhongThi)).Select(x => x.PhongThi).Distinct().Count();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Quản Lý Hội Đồng Coi Thi</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="p-4 bg-light">
    <div class="container" style="max-width: 1100px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="text-primary fw-bold">QUẢN LÝ HỘI ĐỒNG COI THI</h3>
            <div>
                <button onclick="phanCongGiamThi()" class="btn btn-warning fw-bold me-2">⚡ Tự Động Phân Công Giám Thị</button>
                <a href="/adminso" class="btn btn-secondary">Về Trang Sở</a>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-md-5">
                <div class="card p-3 shadow-sm">
                    <h5>Thêm Cán Bộ / Giám Thị Mới</h5>
                    <form id="formCanBo" class="mt-2">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Họ và Tên Cán Bộ</label>
                            <input type="text" id="hoTen" class="form-control" placeholder="Nguyễn Văn A" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Đơn Vị Công Tác (Trường)</label>
                            <input type="text" id="donVi" class="form-control" placeholder="THPT Lê Quý Đôn" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Chức Vũ / Nhiệm Vụ</label>
                            <input type="text" id="chucVu" class="form-control" placeholder="Giám thị / Cán bộ coi thi">
                        </div>
                        <button type="submit" class="btn btn-primary w-100 fw-bold">Thêm Cán Bộ</button>
                    </form>
                </div>
            </div>

            <div class="col-md-7">
                <div class="card p-3 shadow-sm">
                    <h5>Thống Kế Hội Đồng Coi Thi</h5>
                    <div class="alert alert-info">
                        - Tổng số phòng thi hiện tại: <b>@tongPhong phòng</b><br>
                        - Cần tối thiểu: <b>@(tongPhong * 2) giám thị</b> (mỗi phòng 2 giám thị)<br>
                        - Hiện có: <b class="text-success">@dsCanBo.Count cán bộ/giám thị</b>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white fw-bold">DANH SÁCH CÁN BỘ COI THI (@dsCanBo.Count cán bộ)</div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover m-0 align-middle">
                    <thead class="table-secondary">
                        <tr>
                            <th>STT</th>
                            <th>Họ và Tên</th>
                            <th>Đơn Vị Công Tác</th>
                            <th>Chức Vụ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (dsCanBo.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted">Chưa có cán bộ coi thi.</td></tr>
                        }
                        else
                        {
                            @for (int i = 0; i < dsCanBo.Count; i++)
                            {
                                var cb = dsCanBo[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td><b>@cb.HoTen</b></td>
                                    <td>@cb.DonViCongTac</td>
                                    <td>@cb.ChucVu</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('formCanBo').onsubmit = async (e) => {
            e.preventDefault();
            const payload = {
                hoTen: document.getElementById('hoTen').value,
                donViCongTac: document.getElementById('donVi').value,
                chucVu: document.getElementById('chucVu').value
            };

            const res = await fetch('/api/so/them-can-bo', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            alert(data.message);
            if (res.ok) location.reload();
        };

        async function phanCongGiamThi() {
            if (confirm("Xác nhận tự động phân công Giám thị 1 và Giám thị 2 vào tất cả các phòng thi?")) {
                const res = await fetch('/api/so/phan-cong-giam-thi', { method: 'POST' });
                const data = await res.json();
                alert(data.message);
                if (res.ok) window.location.href = "/danhsachphongthi";
            }
        }
    </script>
</body>
</html>
